# Copy to .env for local native development (do not commit .env).

# Database (matches docker-compose `db`)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=donburi_development

# Invite code required to sign up. Rotate per event.
INVITE_CODE=dev-invite

# Non-removable training banner shown on every page.
# EXERCISE_BANNER=【訓練用】...

# Base URL the PDF renderer uses to fetch invoice HTML (defaults to 127.0.0.1:PORT).
# INTERNAL_BASE_URL=http://127.0.0.1:3000

# Path to the wkhtmltopdf binary (defaults to `wkhtmltopdf` on PATH).
# WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf
