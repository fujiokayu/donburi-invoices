<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= content_for(:title).presence || "Donburi 請求管理" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <div class="exercise-banner" role="alert">
      <%= Donburi::Exercise.banner_text %>
    </div>

    <header class="topbar">
      <a class="brand" href="<%= root_path %>">🍜 Donburi</a>
      <nav>
        <% if logged_in? %>
          <span class="org"><%= current_organization.name %></span>
          <%= link_to "請求書", invoices_path %>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "linkish" %>
        <% else %>
          <%= link_to "ログイン", login_path %>
          <%= link_to "新規登録", signup_path %>
        <% end %>
      </nav>
    </header>

    <% if flash.any? %>
      <div class="flashes">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type %>"><%= message %></div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <%= Donburi::Exercise.banner_text %>
    </footer>
  </body>
</html>
