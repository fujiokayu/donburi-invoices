<% content_for :title, "新規登録" %>
<div class="auth-card">
  <h1>新規登録</h1>
  <%= form_with url: signup_path, method: :post do |f| %>
    <div class="field">
      <%= f.label :organization_name, "会社名 / テナント名" %>
      <%= text_field_tag :organization_name %>
    </div>
    <div class="field">
      <%= f.label :name, "お名前" %>
      <%= text_field_tag :name, @user&.name %>
    </div>
    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= email_field_tag :email, @user&.email, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= f.label :password, "パスワード（10文字以上）" %>
      <%= password_field_tag :password, nil, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :invite_code, "招待コード" %>
      <%= text_field_tag :invite_code %>
    </div>
    <%= f.submit "登録", class: "btn btn-primary" %>
  <% end %>
</div>
