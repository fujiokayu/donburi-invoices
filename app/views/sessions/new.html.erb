<% content_for :title, "ログイン" %>
<div class="auth-card">
  <h1>ログイン</h1>
  <%= form_with url: login_path, method: :post do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>
    <%= f.submit "ログイン", class: "btn btn-primary" %>
  <% end %>
  <p class="muted">アカウントがない場合は <%= link_to "新規登録", signup_path %>（招待コードが必要です）。</p>
</div>
