<%= form_with model: invoice do |f| %>
  <% if invoice.errors.any? %>
    <div class="errors">
      <ul>
        <% invoice.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :customer_name, "請求先" %>
    <%= f.text_field :customer_name %>
  </div>

  <div class="field">
    <%= f.label :due_on, "支払期限" %>
    <%= f.date_field :due_on %>
  </div>

  <div class="field">
    <%= f.label :status, "状態" %>
    <%= f.select :status, Invoice.statuses.keys.map { |k| [t("invoice.status.#{k}"), k] } %>
  </div>

  <div class="field">
    <%= f.label :bank_account_id, "お振込先" %>
    <%= f.collection_select :bank_account_id, current_organization.bank_accounts, :id, :label,
                            include_blank: "（なし）" %>
  </div>

  <fieldset class="lines">
    <legend>明細</legend>
    <%= f.fields_for :invoice_lines do |lf| %>
      <div class="line-row">
        <%= lf.text_field :description, placeholder: "項目" %>
        <%= lf.number_field :quantity, value: lf.object.quantity || 1, min: 1 %>
        <%= lf.number_field :unit_price, placeholder: "単価(円)", min: 0 %>
      </div>
    <% end %>
    <p class="muted">単価は円単位で入力します。</p>
  </fieldset>

  <div class="field">
    <%= f.label :notes, "備考" %>
    <%= f.text_area :notes, rows: 4 %>
  </div>

  <div class="actions">
    <%= f.submit "保存", class: "btn btn-primary" %>
    <%= link_to "キャンセル", invoices_path, class: "btn" %>
  </div>
<% end %>
